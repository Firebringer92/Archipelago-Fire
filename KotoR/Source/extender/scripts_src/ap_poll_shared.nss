// XP handling has moved off the old in-game revert-on-detect design
// entirely: the game no longer decides what XP is 'legitimate'. It just
// honestly reports current XP every poll -- the AP client is authoritative
// on what XP the player SHOULD have (sum of AP-granted XP items so far)
// and sends back a SetXP correction through the existing apply pipeline
// when the reported value doesn't match. No in-game persistence needed.
void CheckXP()
{
    object oPC = GetFirstPC();
    KSE_Diag(24, "AP|XPREPORT|current=" + IntToString(GetXP(oPC)));
}

// Same stateless model as XP -- credits picked up from loot/kills need the
// same suppression treatment as items, not just the explicit "credits" AP
// grant item. The STOREOPENED markers already snapshot credits at the start
// of a purchase; this is the continuous every-poll report the client needs
// to know the current total at all, same role CheckXP plays for XP.
void CheckCredits()
{
    object oPC = GetFirstPC();
    KSE_Diag(29, "AP|CREDITSREPORT|current=" + IntToString(GetGold(oPC)));
}

// Same stateless design again: ability scores are granted as PERMANENT
// effects (EffectAbilityIncrease + DURATION_TYPE_PERMANENT), which are
// tied to the specific character save they were applied to -- a brand
// new save (or a restarted playthrough) starts with none of them, same
// as vanilla. Reporting current scores every poll lets the client notice
// a fresh save is behind what's actually been earned and reapply the
// missing effects automatically, instead of the player losing progress.
void CheckAbilityScores()
{
    object oPC = GetFirstPC();
    string sReport = "AP|ABILITYREPORT|str=" + IntToString(GetAbilityScore(oPC, ABILITY_STRENGTH))
        + "|dex=" + IntToString(GetAbilityScore(oPC, ABILITY_DEXTERITY))
        + "|con=" + IntToString(GetAbilityScore(oPC, ABILITY_CONSTITUTION))
        + "|int=" + IntToString(GetAbilityScore(oPC, ABILITY_INTELLIGENCE))
        + "|wis=" + IntToString(GetAbilityScore(oPC, ABILITY_WISDOM))
        + "|cha=" + IntToString(GetAbilityScore(oPC, ABILITY_CHARISMA));
    KSE_Diag(27, sReport);
}

// Reports current Jedi class levels every poll so the client can check
// 'does this character already have class X' BEFORE sending a class-switch
// grant, not just trust its own delivery bookkeeping. AddMultiClass +
// ShowLevelUpGUI are one-shot, not safe to re-fire (confirmed: re-applying
// class_sentinel on an already-multiclassed character as part of a reconnect
// resend crashed the game). Bookkeeping alone can't be trusted across saves
// (an older save reloaded later may genuinely still need the grant), so this
// reads real game state instead -- self-correcting regardless of which save
// is currently loaded.
void CheckClasses()
{
    object oPC = GetFirstPC();
    string sReport = "AP|CLASSREPORT|guardian=" + IntToString(GetLevelByClass(CLASS_TYPE_JEDIGUARDIAN, oPC))
        + "|consular=" + IntToString(GetLevelByClass(CLASS_TYPE_JEDICONSULAR, oPC))
        + "|sentinel=" + IntToString(GetLevelByClass(CLASS_TYPE_JEDISENTINEL, oPC));
    int nBaseClass = GetClassByPosition(1, oPC);
    int nBaseLevel = GetLevelByPosition(1, oPC);
    sReport = sReport + "|baseclass=" + IntToString(nBaseClass) + "|baselevel=" + IntToString(nBaseLevel);
    KSE_Diag(65, sReport);
}

// Traps feature (2026-09-08) -- reports every feat.2da id the character
// currently holds (KSE_GetFeatAcquired is per-id membership only, there's
// no 'list all feats' native), so the client can pick half at random for
// the Remove Half Known Feats trap without guessing at what's held.
