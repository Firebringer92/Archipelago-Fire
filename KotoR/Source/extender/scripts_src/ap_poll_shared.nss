// Character name, reported every poll -- the client keys its persistent
// delivery log on (character name, item index) so a fresh character (a
// deliberate restart) gets everything re-granted, while reconnecting to the
// SAME character doesn't replay history it's already received. See
// KotorClient.py's delivery log for the other half of this.
void CheckCharacterName()
{
    object oPC = GetFirstPC();
    KSE_Diag(66, "AP|NAMEREPORT|" + GetName(oPC));
}

// Same stateless design as everything above. Skills are already grantable
// via KSE_AdjustCreatureSkills (proven working in an earlier phase) -- this
// is just the reporting half, so the client can be authoritative on what
// skill ranks the player should have (same as XP/credits/inventory) rather
// than the game deciding anything for itself.
void CheckSkills()
{
    object oPC = GetFirstPC();
    string sReport = "AP|SKILLREPORT|computeruse=" + IntToString(GetSkillRank(SKILL_COMPUTER_USE, oPC))
        + "|demolitions=" + IntToString(GetSkillRank(SKILL_DEMOLITIONS, oPC))
        + "|stealth=" + IntToString(GetSkillRank(SKILL_STEALTH, oPC))
        + "|awareness=" + IntToString(GetSkillRank(SKILL_AWARENESS, oPC))
        + "|persuade=" + IntToString(GetSkillRank(SKILL_PERSUADE, oPC))
        + "|repair=" + IntToString(GetSkillRank(SKILL_REPAIR, oPC))
        + "|security=" + IntToString(GetSkillRank(SKILL_SECURITY, oPC))
        + "|treatinjury=" + IntToString(GetSkillRank(SKILL_TREAT_INJURY, oPC));
    KSE_Diag(28, sReport);
}

// Same stateless design as CheckXP() -- the game doesn't decide what's
// legitimate, it just honestly reports current inventory (backpack +
// equipped slots) every poll. The AP client correlates this against its
// own memory (starting kit, AP grants, and STOREOPENED snapshots from
// ap_store suppressors) to decide what should be removed. Backpack items
// use GetFirstItemInInventory/GetNextItemInInventory; GetFirstItemInInventory
// does NOT include equipped gear, so equipped slots are checked separately.
void CheckInventory()
{
    object oPC = GetFirstPC();
    string sReport = "AP|INVENTORY|";

    object oItem = GetFirstItemInInventory(oPC);
    while (GetIsObjectValid(oItem))
    {
        sReport = sReport + GetTag(oItem) + ":" + IntToString(GetItemStackSize(oItem)) + ",";
        oItem = GetNextItemInInventory(oPC);
    }

    object oEq;
    oEq = GetItemInSlot(INVENTORY_SLOT_HEAD, oPC);
    if (GetIsObjectValid(oEq))
    {
        sReport = sReport + "EQ_HEAD:" + GetTag(oEq) + ",";
    }
    oEq = GetItemInSlot(INVENTORY_SLOT_BODY, oPC);
    if (GetIsObjectValid(oEq))
    {
        sReport = sReport + "EQ_BODY:" + GetTag(oEq) + ",";
    }
    oEq = GetItemInSlot(INVENTORY_SLOT_HANDS, oPC);
    if (GetIsObjectValid(oEq))
    {
        sReport = sReport + "EQ_HANDS:" + GetTag(oEq) + ",";
    }
    oEq = GetItemInSlot(INVENTORY_SLOT_RIGHTWEAPON, oPC);
    if (GetIsObjectValid(oEq))
    {
        sReport = sReport + "EQ_RWEAPON:" + GetTag(oEq) + ",";
    }
    oEq = GetItemInSlot(INVENTORY_SLOT_LEFTWEAPON, oPC);
    if (GetIsObjectValid(oEq))
    {
        sReport = sReport + "EQ_LWEAPON:" + GetTag(oEq) + ",";
    }
    oEq = GetItemInSlot(INVENTORY_SLOT_LEFTARM, oPC);
    if (GetIsObjectValid(oEq))
    {
        sReport = sReport + "EQ_LARM:" + GetTag(oEq) + ",";
    }
    oEq = GetItemInSlot(INVENTORY_SLOT_RIGHTARM, oPC);
    if (GetIsObjectValid(oEq))
    {
        sReport = sReport + "EQ_RARM:" + GetTag(oEq) + ",";
    }
    oEq = GetItemInSlot(INVENTORY_SLOT_IMPLANT, oPC);
    if (GetIsObjectValid(oEq))
    {
        sReport = sReport + "EQ_IMPLANT:" + GetTag(oEq) + ",";
    }
    oEq = GetItemInSlot(INVENTORY_SLOT_BELT, oPC);
    if (GetIsObjectValid(oEq))
    {
        sReport = sReport + "EQ_BELT:" + GetTag(oEq) + ",";
    }

    KSE_Diag(26, sReport);
}

// DeathLink outgoing half. Same stateless design as everything else here --
// just honestly reports whether the PC is currently dead every poll, no
// in-game persistence or edge-detection. The client is authoritative on
// dedup (only bounce one DeathLink per death, reset once alive again) since
// custom globals don't persist across saves/reloads and this event will
// otherwise repeat every single poll for as long as the player stays dead.
void CheckDeath()
{
    object oPC = GetFirstPC();
    if (GetIsDead(oPC))
    {
        KSE_Diag(64, "AP|CHECK|DEATH");
    }
}

// Light/dark alignment, reported every poll -- same stateless design as
// everything else here. GetGoodEvilValue is 0 (full dark) to 100 (full
// light), 50 neutral. The client tracks the last-known value itself and
// derives newly-crossed 10-point thresholds (and the True Neutral/Fallen
// Jedi/Redeemed Sith bonus checks, which need a bit of history) -- see
// kotor_location_tracker.py.
void CheckAlignment()
{
    object oPC = GetFirstPC();
    KSE_Diag(83, "AP|ALIGNMENT|" + IntToString(GetGoodEvilValue(oPC)));
}

// Goal detection: STA_MALAK_DEAD is a real, pre-declared globalcat.2da
// Boolean, set unconditionally true in sta_m45ad across every narrative
// branch of Malak's death (k_psta_mlkend/k_psta_ud_malak and its _mal2-8
// variants) and never reset -- same proven detection shape as the _DONE
// quest flags above, just not sharing their naming convention so it isn't
// swept up by the generic *_DONE scan. Reported unconditionally once true,
// same stateless design as everything else here -- the client decides what
// to do with it (only the defeat_malak Goal option cares).
void CheckGoal()
{
    if (GetGlobalBoolean("STA_MALAK_DEAD"))
    {
        KSE_Diag(84, "AP|CHECK|GOAL|MALAK_DEAD");
    }
}

// Character level, for the max_level Goal option. GetHitDice returns total
// character level regardless of class/multiclass split -- exactly the same
// number exptable.2da's cumulative XP thresholds are keyed on.
void CheckLevel()
{
    object oPC = GetFirstPC();
    KSE_Diag(85, "AP|LEVELREPORT|" + IntToString(GetHitDice(oPC)));
}

void main()
{
    CheckQuests();
    CheckPlot();
    CheckJournal();
    CheckXP();
    CheckCredits();
    CheckInventory();
    CheckAbilityScores();
    CheckClasses();
    CheckFeats();
    CheckForcePowers();
    CheckCharacterName();
    CheckSkills();
    CheckDeath();
    CheckAlignment();
    CheckGoal();
    CheckLevel();

    // Self-healing heartbeat restart, staleness-based (not a one-shot flag).
    // Confirmed this session: a same-process in-game Load Game silently kills
    // the heartbeat's DelayCommand chain while leaving KSE's in-session data
    // store untouched (that store is DLL-memory, tied to the process, not the
    // save) -- so a one-shot "hb_started" flag that's only ever SET, never
    // cleared, can never detect that case: it stays true forever after the
    // first start, even once the actual heartbeat is dead. Fixed by having
    // Tick() stamp the current time into KSE data on every tick, and treating
    // the heartbeat as dead if that stamp is missing OR older than 20s (4x
    // the 5s tick interval, generous slack for scheduling jitter). This also
    // replaces hb_started entirely -- covers first-ever start (no stamp yet),
    // full process restart (KSE store wiped, no stamp), and a same-process
    // Load Game (stamp present but stale) with the same single check.
    int nNow = GetTimeHour() * 3600 + GetTimeMinute() * 60 + GetTimeSecond();
    int nHeartbeatDead = 1;
    if (KSE_HasData("hb_tick_time"))
    {
        int nLastTick = StringToInt(KSE_GetData("hb_tick_time"));
        int nDelta = nNow - nLastTick;
        if (nDelta < 0) nDelta = nDelta + 86400; // midnight wraparound
        if (nDelta < 20) nHeartbeatDead = 0;
    }
    if (nHeartbeatDead)
    {
        // Stamp immediately, before the new heartbeat's own first tick runs --
        // otherwise a second poll_shared call arriving moments later (e.g. a
        // module-load and an area-enter firing back to back) would still see
        // a stale/missing stamp and spawn a SECOND heartbeat, double-ticking
        // everything from then on.
        KSE_SetData("hb_tick_time", IntToString(nNow));
        ExecuteScript("ap_heartbeat", OBJECT_SELF);
    }
}
