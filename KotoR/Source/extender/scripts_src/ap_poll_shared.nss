    sNow = sNow + GetStringRight(IntToString(1000 + GetJournalEntry("k_swg_carthtalk")), 3);
    sNow = sNow + GetStringRight(IntToString(1000 + GetJournalEntry("kas23_mainwookplot")), 3);
