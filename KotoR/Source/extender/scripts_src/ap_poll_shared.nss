// Character name, reported every poll -- the client keys its persistent
// delivery log on (character name, item index) so a fresh character (a
// deliberate restart) gets everything re-granted, while reconnecting to the
// SAME character doesn't replay history it's already received. See
// KotorClient.py's delivery log for the other half of this.
void CheckCharacterName()
{
    object oPC = GetFirstPC();
    KSE_Diag(66, "AP|NAMEREPORT|" + GetName(oPC));
}

// Same stateless design as everything above. Skills are already grantable
// via KSE_AdjustCreatureSkills (proven working in an earlier phase) -- this
// is just the reporting half, so the client can be authoritative on what
// skill ranks the player should have (same as XP/credits/inventory) rather
// than the game deciding anything for itself.
//
// GetSkillRank is NOT the rank -- it adds the ability modifier and any
// effects, so it moves with abilities, gear and combat debuffs. The native
// selector below logs the eight TRUE ranks as AP|SKILLBASEREPORT; it runs
// BEFORE the SKILLREPORT line because SKILLREPORT is the cycle-complete
// marker that triggers reconciliation, which needs the true ranks in hand.
void CheckSkills()
{
    object oPC = GetFirstPC();
    KSE_SetCreatureField(oPC, KSE_FIELD_REPORT_SKILL_RANKS(), 0);
    string sReport = "AP|SKILLREPORT|computeruse=" + IntToString(GetSkillRank(SKILL_COMPUTER_USE, oPC))
        + "|demolitions=" + IntToString(GetSkillRank(SKILL_DEMOLITIONS, oPC))
        + "|stealth=" + IntToString(GetSkillRank(SKILL_STEALTH, oPC))
        + "|awareness=" + IntToString(GetSkillRank(SKILL_AWARENESS, oPC))
        + "|persuade=" + IntToString(GetSkillRank(SKILL_PERSUADE, oPC))
        + "|repair=" + IntToString(GetSkillRank(SKILL_REPAIR, oPC))
        + "|security=" + IntToString(GetSkillRank(SKILL_SECURITY, oPC))
        + "|treatinjury=" + IntToString(GetSkillRank(SKILL_TREAT_INJURY, oPC));
    KSE_Diag(28, sReport);
}

// No CheckInventory() here: it used to build ONE giant string
// via repeated concatenation across the whole backpack + equipped slots
// (sReport = sReport + GetTag(oItem) + ...), reported as AP|INVENTORY|...
// every poll. NWScript's own string type
// has a hard ~512-byte engine limit, and a real 28+-item backpack
// truncates mid-word well before the scan finishes. This silently lost
// data for ANY tag near the end of a large enough backpack (see
// CheckBountyCount() below for its targeted
// single-tag replacement, which can't hit this limit since it only ever
// emits a bounded integer, never a per-item concatenation). The only other
// consumer, kotor_reconciliation.py's current_inventory (Remove Half
// Inventory trap), no longer needs a live poll at all -- that trap now
// does its own on-demand inventory walk + native random selection
// entirely in NWScript at delivery time (see generate_trampoline_batch.py's
// build_trap_block, remove_half_inventory branch), so dropping this
// function removes a full inventory walk + string build from every single
// 5-second heartbeat tick with no functional loss.

// DeathLink outgoing half. Same stateless design as everything else here --
// just honestly reports whether the PC is currently dead every poll, no
// in-game persistence or edge-detection. The client is authoritative on
// dedup (only bounce one DeathLink per death, reset once alive again) since
// custom globals don't persist across saves/reloads and this event will
// otherwise repeat every single poll for as long as the player stays dead.
void CheckDeath()
{
    object oPC = GetFirstPC();
    if (GetIsDead(oPC))
    {
        KSE_Diag(64, "AP|CHECK|DEATH");
    }
}

// Bounty Card count -- replaces the old AP|INVENTORY-based
// _bounty_card_count parsing, which relied on CheckInventory()'s giant
// concatenated string (see the comment above for the 512-byte
// truncation this hit). This scans for exactly ONE tag and emits a
// single bounded integer, never a per-item string build, so it can't hit
// that limit no matter how large the backpack is. Only generated when
// additional_enemies_mode != 0 for this seed -- bounty carriers don't
// exist at all otherwise, so the scan would be pure waste.
void CheckBountyCount()
{
    object oPC = GetFirstPC();
    int nCount = 0;
    object oItem = GetFirstItemInInventory(oPC);
    while (GetIsObjectValid(oItem))
    {
        if (GetTag(oItem) == "ap_bounty_card") nCount = nCount + GetItemStackSize(oItem);
        oItem = GetNextItemInInventory(oPC);
    }

    // Only report on an actual change -- same only-when-it-moves shape as
    // the rest of this file's stateful checks, avoids re-sending an
    // unchanged count every 5s for as long as the player holds any cards.
    int nLast = -1;
    if (KSE_HasData("bounty_last_count")) nLast = StringToInt(KSE_GetData("bounty_last_count"));
    if (nCount != nLast)
    {
        KSE_SetData("bounty_last_count", IntToString(nCount));
        KSE_Diag(157, "AP|BOUNTY|COUNT|" + IntToString(nCount));
    }
}

// Light/dark alignment, reported every poll -- same stateless design as
// everything else here. GetGoodEvilValue is 0 (full dark) to 100 (full
// light), 50 neutral. The client tracks the last-known value itself and
// derives newly-crossed thresholds (and the Fallen
// Jedi/Redeemed Sith bonus checks, which need a bit of history) -- see
// kotor_location_tracker.py.
void CheckAlignment()
{
    object oPC = GetFirstPC();
    KSE_Diag(83, "AP|ALIGNMENT|" + IntToString(GetGoodEvilValue(oPC)));
}

// Goal detection: STA_MALAK_DEAD is a real, pre-declared globalcat.2da
// Boolean, set unconditionally true in sta_m45ad across every narrative
// branch of Malak's death (k_psta_mlkend/k_psta_ud_malak and its _mal2-8
// variants) and never reset -- same proven detection shape as the _DONE
// quest flags above, just not sharing their naming convention so it isn't
// swept up by the generic *_DONE scan. Reported unconditionally once true,
// same stateless design as everything else here -- the client decides what
// to do with it (only the defeat_malak Goal option cares).
void CheckGoal()
{
    if (GetGlobalBoolean("STA_MALAK_DEAD"))
    {
        KSE_Diag(84, "AP|CHECK|GOAL|MALAK_DEAD");
    }
}

// Character level, for the max_level Goal option. GetHitDice returns total
// character level regardless of class/multiclass split -- exactly the same
// number exptable.2da's cumulative XP thresholds are keyed on.
void CheckLevel()
{
    object oPC = GetFirstPC();
    KSE_Diag(85, "AP|LEVELREPORT|" + IntToString(GetHitDice(oPC)));
}

// Feeds the delevel reconciler's Force-point scaling (see
// kotor_reconciliation.py's _FORCE_RE/current_force) -- GetCurrentForcePoints()/
// GetMaxForcePoints() and GetLevelByClass() above are real standard
// natives, no new offset/native needed just to READ these.
//
// GUARD: GetCurrentForcePoints()/
// GetMaxForcePoints() crash the game when called on the PC immediately
// after a raw AddMultiClass()+CLASS1_LEVEL=1 grant (class_consular),
// before any real UI level-up has happened -- the crash fires
// on this poll's own automatic next tick, not any player action (no
// character sheet/inventory/Force Powers screen needs to be opened, and the class
// change need never even be visually seen before the crash). Matches this
// project's own earlier companion-class-switch finding that a freshly
// multiclassed slot's underlying Force-power data isn't allocated until a
// real level-up runs -- these two natives apparently need to walk that
// same not-yet-allocated structure, unlike a raw KSE_FIELD_FORCE offset
// read/write, which doesn't. Skip while any Jedi slot is fresh (total
// Jedi levels == 1) -- exactly the dangerous state, and not useful data
// anyway since every real formula data point so far came from levels well
// past this point.
void CheckForce()
{
    object oPC = GetFirstPC();
    int nJediTotal = GetLevelByClass(CLASS_TYPE_JEDIGUARDIAN, oPC)
        + GetLevelByClass(CLASS_TYPE_JEDICONSULAR, oPC)
        + GetLevelByClass(CLASS_TYPE_JEDISENTINEL, oPC);
    if (nJediTotal == 1) return;
    KSE_Diag(137, "AP|FORCEREPORT|current=" + IntToString(GetCurrentForcePoints(oPC))
        + "|max=" + IntToString(GetMaxForcePoints(oPC)));
}

// Restarts the heartbeat when it is dead (see the comment below). Called FIRST in
// main(), and again at the end: it used to run only at the end, so a poll that
// stopped partway on an area entry (seen live, 2026-10-04: polling and the
// heartbeat stayed dead for almost three minutes until the area was reloaded)
// never got to restart it.
void EnsureHeartbeat()
{
    // Self-healing heartbeat restart, staleness-based (not a one-shot flag).
    // Confirmed this session: a same-process in-game Load Game silently kills
    // the heartbeat's DelayCommand chain while leaving KSE's in-session data
    // store untouched (that store is DLL-memory, tied to the process, not the
    // save) -- so a one-shot "hb_started" flag that's only ever SET, never
    // cleared, can never detect that case: it stays true forever after the
    // first start, even once the actual heartbeat is dead. Fixed by having
    // Tick() stamp the current time into KSE data on every tick, and treating
    // the heartbeat as dead if that stamp is missing OR older than 20s (4x
    // the 5s tick interval, generous slack for scheduling jitter). This also
    // replaces hb_started entirely -- covers first-ever start (no stamp yet),
    // full process restart (KSE store wiped, no stamp), and a same-process
    // Load Game (stamp present but stale) with the same single check.
    int nNow = GetTimeHour() * 3600 + GetTimeMinute() * 60 + GetTimeSecond();
    int nHeartbeatDead = 1;
    if (KSE_HasData("hb_tick_time"))
    {
        int nLastTick = StringToInt(KSE_GetData("hb_tick_time"));
        int nDelta = nNow - nLastTick;
        if (nDelta < 0) nDelta = nDelta + 86400; // midnight wraparound
        if (nDelta < 20) nHeartbeatDead = 0;
    }
    if (nHeartbeatDead)
    {
        // Stamp immediately, before the new heartbeat's own first tick runs --
        // otherwise a second poll_shared call arriving moments later (e.g. a
        // module-load and an area-enter firing back to back) would still see
        // a stale/missing stamp and spawn a SECOND heartbeat, double-ticking
        // everything from then on.
        KSE_SetData("hb_tick_time", IntToString(nNow));
        ExecuteScript("ap_heartbeat", OBJECT_SELF);
    }
}

// starting_class=droid: the PC's HK-47 variant look is a permanent EffectDisguise (the pc_droid arm applies it).
// Vanilla scripts that end a disguise remove EVERY disguise effect on the party -- the Manaan underwater
// level's RemoveSuits(), the Tatooine sand-person and Leviathan disguises -- which would silently drop that
// look. This puts it back whenever the PC is a Battle Droid (race 5, class 9) with no disguise at all;
// while a vanilla disguise is active it does nothing, so it never fights the suit or the sand-person robe.
void CheckDroidLook()
{
    object oPC = GetFirstPC();
    if (GetRacialType(oPC) != 5 || GetClassByPosition(1, oPC) != 9) return;
    effect eFx = GetFirstEffect(oPC);
    while (GetIsEffectValid(eFx))
    {
        if (GetEffectType(eFx) == EFFECT_TYPE_DISGUISE) return;
        eFx = GetNextEffect(oPC);
    }
    ApplyEffectToObject(DURATION_TYPE_PERMANENT, EffectDisguise(1), oPC);
    KSE_Diag(188, "AP|DROIDLOOK|restored");
}

void main()
{
    // A begin without an end in kse.log marks a poll that stopped partway. The stage markers
    // s1-s4 (which find WHERE it stopped) are only logged when the previous poll never reached
    // its end, so a poll that keeps stopping at the same place leaves its trail from the next
    // poll on without four extra lines on every healthy poll.
    int bTrace = (KSE_HasData("poll_open") && KSE_GetData("poll_open") == "1");
    KSE_SetData("poll_open", "1");
    KSE_Diag(176, "AP|POLLRUN|begin|party=" + IntToString(GetPartyMemberCount()));
    EnsureHeartbeat();
    if (bTrace) KSE_Diag(176, "AP|POLLRUN|s1");
    CheckCompanionStuck();
    if (bTrace) KSE_Diag(176, "AP|POLLRUN|s2");
    CheckPartyLevels();
    if (bTrace) KSE_Diag(176, "AP|POLLRUN|s3");
    CheckJoleeFieldRevert();
    if (bTrace) KSE_Diag(176, "AP|POLLRUN|s4");
    CheckQuests();
    CheckPlot();
    CheckJournal();
    CheckRecruitMarkers();
    CheckCrewMarkers();
    CheckXP();
    CheckCredits();
    CheckAbilityScores();
    CheckClasses();
    CheckDroidLook();
    CheckCompanionClasses();
    CheckCompanionFeats();
    CheckRoster();
    CheckProgressionItems();
    CheckBossDatapads();
    CheckVisitedMarkers();
    CheckPlayerId();
    CheckHideoutCarth();
    CheckAPTrackerStage();
    CheckFeats();
    CheckFeatsFull();
    CheckForcePowers();
    CheckCharacterName();
    CheckSkills();
    CheckDeath();
    CheckBountyCount();
    CheckAlignment();
    CheckGoal();
    CheckLevel();
    CheckForce();

    EnsureHeartbeat();
    KSE_SetData("poll_open", "0");
    KSE_Diag(176, "AP|POLLRUN|end");
}
