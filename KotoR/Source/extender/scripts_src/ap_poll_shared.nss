    {
        KSE_Diag(25, "AP|CHECK|PLOT|MAN_MURDER_PLOT|value=" + IntToString(nMAN_MURDER_PLOT));
    }
    int nMAN_RODIAN_PLOT = GetGlobalNumber("MAN_RODIAN_PLOT");
