    int bTokDan3 = GetIsObjectValid(GetItemPossessedBy(oPC, "ap_tk_dan3"));
    sReport = sReport + "|tok_dan3=" + IntToString(bTokDan3);
    int bTokTat1 = GetIsObjectValid(GetItemPossessedBy(oPC, "ap_tk_tat1"));
