    {
        KSE_Diag(25, "AP|CHECK|PLOT|MAN_PLANET_PLOT|value=" + IntToString(nMAN_PLANET_PLOT));
    }
    int nMAN_MURDER_PLOT = GetGlobalNumber("MAN_MURDER_PLOT");
