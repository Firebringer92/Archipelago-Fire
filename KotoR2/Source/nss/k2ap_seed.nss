// Bit number of a story gate in the disabled-gates mask, -1 for an unknown id.
int K2AP_GateBit(string sGate)
{
    if (sGate == "TEL1") return 0;
    if (sGate == "TEL2") return 1;
    if (sGate == "TEL3") return 2;
    if (sGate == "NAR1") return 3;
    if (sGate == "NAR2") return 4;
    if (sGate == "NAR3") return 5;
    if (sGate == "DXN1") return 6;
    if (sGate == "DXN2") return 7;
    if (sGate == "DXN3") return 8;
    if (sGate == "DAN1") return 9;
    if (sGate == "DAN2") return 10;
    if (sGate == "DAN3") return 11;
    if (sGate == "KOR1") return 12;
    if (sGate == "KOR2") return 13;
    if (sGate == "KOR3") return 14;
    if (sGate == "FIN1") return 15;
    if (sGate == "FIN2") return 16;
    if (sGate == "FIN3") return 17;
    if (sGate == "FIN4") return 18;
    return -1;
}

// TRUE when the seed switched the story gate off (sGate like "NAR1").
int K2AP_GateOff(string sGate)
{
    int nBit = K2AP_GateBit(sGate);
    if (nBit < 0) return FALSE;
    return (K2AP_DisabledGates() >> nBit) & 1;
}
