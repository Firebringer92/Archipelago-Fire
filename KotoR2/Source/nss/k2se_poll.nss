// Item log for building the quest-item list from play: with ap_item_log=1 in config.txt, the plot-flagged items the player holds are reported as
// IT|tag~name,tag~name (only when the set changes). The client keeps a csv of what it sees (client/KotorTwoClient.py, tools/item_log_report.py).
void PollItemLog(object oPC)
{
    if (K2SE_ConfigInt("ap_item_log", 0) == 0) return;
    string s = "";
    object oItem = GetFirstItemInInventory(oPC);
    while (GetIsObjectValid(oItem))
    {
        if (GetPlotFlag(oItem)) s = s + GetTag(oItem) + "~" + GetName(oItem) + ",";
        oItem = GetNextItemInInventory(oPC);
    }
    string t = "";
    if (s != "") t = GetStringLeft(s, GetStringLength(s) - 1);
    PollReport("pit", s, "IT|" + t);
}

// the Bazaar: B|<purchases>|<token exchanges>, the number of receipt items the player holds (a deal gives one receipt; nss/k2ap_bazaar.nss)
void PollBazaar(object oPC)
{
    int nBuy = 0;
    int nSwap = 0;
    object oItem = GetFirstItemInInventory(oPC);
    while (GetIsObjectValid(oItem))
    {
        if (GetTag(oItem) == "ap_bz_buy") nBuy += GetItemStackSize(oItem);
        else if (GetTag(oItem) == "ap_bz_swap") nSwap += GetItemStackSize(oItem);
        oItem = GetNextItemInInventory(oPC);
    }
    if (nBuy + nSwap > 0) PollReport("pbz", IntToString(nBuy) + "," + IntToString(nSwap), "B|" + IntToString(nBuy) + "|" + IntToString(nSwap));
}

void PollAll(object oPC)
{
    PollQuests(oPC);
    PollCharacter(oPC);
    PollDeath(oPC);
    PollCompanions(oPC);
    PollQuestItems(oPC);
    PollItemLog(oPC);
    PollBazaar(oPC);
}
